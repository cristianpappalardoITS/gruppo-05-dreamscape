# Copiare in .env (che resta fuori dal repository) e cambiare la password.
POSTGRES_DB=dreamscape
POSTGRES_USER=dreamscape
POSTGRES_PASSWORD=cambiami

# Chiave condivisa tra backend e motore di gioco (intestazione X-Engine-Key, decisione 029).
# Facoltativa in sviluppo: senza, Docker Compose e il backend usano la stessa chiave di prova.
# Alla consegna è obbligatoria e va cambiata
# ENGINE_API_KEY=cambiami
